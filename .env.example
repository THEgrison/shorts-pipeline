# --- App ---
APP_NAME=shorts-pipeline
APP_ENV=development
DEBUG=false
DRY_RUN=true
LOG_LEVEL=INFO
LOG_JSON=true
API_HOST=0.0.0.0
API_PORT=8742
SECRET_KEY=change-me-in-production-use-a-long-random-string
# Generate with: uv run shorts-pipeline gen-fernet-key
FERNET_KEY=change-me-generate-with-shorts-pipeline-gen-fernet-key

# --- Database ---
DATABASE_URL=postgresql+asyncpg://shorts:shorts@localhost:5432/shorts_pipeline
DATABASE_URL_SYNC=postgresql+psycopg2://shorts:shorts@localhost:5432/shorts_pipeline

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- Storage ---
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=/data/shorts
STORAGE_TEMP_DIR=/data/shorts/tmp

# --- Human-in-the-loop ---
REQUIRE_REVIEW=true

# --- Discovery / YouTube Data API v3 ---
YOUTUBE_API_KEY=
YOUTUBE_QUOTA_DAILY_LIMIT=10000
DISCOVERY_MAX_RESULTS_PER_QUERY=25
DISCOVERY_IDEAL_DURATION_MIN_SEC=480
DISCOVERY_IDEAL_DURATION_MAX_SEC=3600
DISCOVERY_ALLOWED_LANGUAGES=fr,en

# --- Analysis ---
WHISPER_MODEL=base
WHISPER_DEVICE=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANALYSIS_MAX_CLIPS_PER_VIDEO=5
ANALYSIS_CLIP_MIN_SEC=20
ANALYSIS_CLIP_MAX_SEC=60

# --- Editing ---
EDITING_WIDTH=1080
EDITING_HEIGHT=1920
EDITING_MAX_DURATION_SEC=60
EDITING_LOUDNORM_LUFS=-14.0
EDITING_DEFAULT_STYLE_TEMPLATE=tiktok_default

# --- Publishing ---
PUBLISHING_MAX_POSTS_PER_DAY=5
PUBLISHING_JITTER_SECONDS=600
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=

# --- Alerts ---
ALERT_WEBHOOK_URL=
ALERT_DISCORD_WEBHOOK_URL=
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=

# --- Metrics ---
METRICS_ENABLED=true
METRICS_PORT=9090
